@model TicketSales.Models.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Restablecer contraseña"; }
<section class="account-auth"><div class="checkout-card"><p class="kicker">CUENTA</p><h1>Restablece tu contraseña</h1><p class="intro">Ingresa el correo de tu cuenta y te enviaremos un enlace seguro.</p><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><button class="btn btn-dark w-100">Enviar enlace</button></form><p class="account-switch"><a asp-action="Login">Volver a iniciar sesión</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
