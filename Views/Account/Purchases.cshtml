@model IReadOnlyList<TicketSales.Models.Account.PurchaseHistoryItemViewModel>
@{
    ViewData["Title"] = "Mis compras";
    string StatusLabel(string status) => status switch
    {
        "Approved" => "Confirmada",
        "Pending" => "En verificación",
        "Rejected" => "Rechazada",
        "Expired" => "Vencida",
        "Review" => "En revisión",
        _ => status
    };
}

<section class="purchase-history">
    <div class="purchase-history-heading">
        <div><p class="kicker">MI CUENTA</p><h1>Mis compras</h1><p>Consulta el estado de tus órdenes y vuelve a abrir tu código QR cuando la compra esté confirmada.</p></div>
        <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Profile">Mi cuenta</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="purchase-history-empty"><h2>Aún no tienes compras</h2><p>Cuando compres entradas con esta cuenta, tus órdenes aparecerán aquí.</p><a class="btn btn-dark" asp-controller="Home" asp-action="Index">Explorar eventos</a></div>
    }
    else
    {
        <div class="purchase-history-list">
            @foreach (var purchase in Model)
            {
                <article class="purchase-history-card">
                    <div class="purchase-history-main"><div class="purchase-history-top"><span class="purchase-status purchase-status-@purchase.PaymentStatus.ToLowerInvariant()">@StatusLabel(purchase.PaymentStatus)</span><time datetime="@purchase.CreatedAt.ToString("O")">@purchase.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</time></div><h2>@purchase.OrderNumber</h2><p>@purchase.ItemSummary</p></div>
                    <div class="purchase-history-actions"><strong>Q @purchase.Total.ToString("N2")</strong><a class="btn btn-dark" asp-controller="Home" asp-action="Confirmation" asp-route-id="@purchase.Id">Ver</a></div>
                </article>
            }
        </div>
    }
</section>
