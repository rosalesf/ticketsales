@model TicketSales.Models.HomeIndexViewModel
@{ ViewData["Title"] = "Eventos"; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger mt-4">@error</div> } @if (TempData["Success"] is string success) { <div class="notice mt-4">✓ @success <a asp-action="Cart">Ver carrito</a></div> }

@if (Model.FeaturedEvents.Any())
{
    <section class="featured-section" aria-label="Eventos destacados">
        <div class="section-heading"><div><p class="kicker">DESTACADOS</p><h2>Eventos para ti</h2></div><p>Selección de eventos que no te puedes perder.</p></div>
        <div id="featuredEventsCarousel" class="carousel slide featured-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">@for (var index = 0; index < Model.FeaturedEvents.Count; index++) { <button type="button" data-bs-target="#featuredEventsCarousel" data-bs-slide-to="@index" class="@(index == 0 ? "active" : null)" aria-current="@(index == 0 ? "true" : null)" aria-label="Evento @(index + 1)"></button> }</div>
            <div class="carousel-inner">@for (var index = 0; index < Model.FeaturedEvents.Count; index++) { var item = Model.FeaturedEvents[index]; var hasBanner = !string.IsNullOrEmpty(item.BannerBase64) && !string.IsNullOrEmpty(item.BannerContentType); <div class="carousel-item @(index == 0 ? "active" : null)"><a class="featured-event @(hasBanner ? "has-banner" : null)" asp-action="Details" asp-route-id="@item.Id" aria-label="Ver detalle de @item.Name">@if (hasBanner) { <img class="featured-event-banner" src="data:@item.BannerContentType;base64,@item.BannerBase64" alt="Banner de @item.Name" /> } else { <div class="featured-event-date"><b>@item.StartsAt.ToString("dd")</b><span>@item.StartsAt.ToString("MMM")</span></div><div class="featured-event-content"><span class="featured-tag">EVENTO DESTACADO</span><h3>@item.Name</h3><p>@item.Description</p><div><span>⌖ @item.Venue</span><span>◷ @item.StartsAt.ToString("dddd, HH:mm")</span></div></div><span class="featured-event-link">Ver detalle <b>→</b></span> }</a></div> }</div>
            @if (Model.FeaturedEvents.Count > 1) { <button class="carousel-control-prev" type="button" data-bs-target="#featuredEventsCarousel" data-bs-slide="prev"><span aria-hidden="true">←</span><span class="visually-hidden">Anterior</span></button><button class="carousel-control-next" type="button" data-bs-target="#featuredEventsCarousel" data-bs-slide="next"><span aria-hidden="true">→</span><span class="visually-hidden">Siguiente</span></button> }
        </div>
    </section>
}

<section id="eventos" class="events-section"><div class="section-heading"><div><p class="kicker">AGENDA</p><h2>Eventos seleccionados</h2></div><p>Consulta los detalles y elige tus entradas.</p></div><div class="row g-4">@foreach (var item in Model.Events) { var hasAvailability = item.TicketTypes.Any(t => t.AvailableTickets > 0); <div class="col-md-6 col-lg-4"><article class="event-card h-100"><div class="event-card-top"><span class="calendar"><b>@item.StartsAt.ToString("dd")</b><small>@item.StartsAt.ToString("MMM")</small></span><span class="availability">@(hasAvailability ? (item.TicketTypes.Sum(t => t.AvailableTickets) > 20 ? "Disponible" : "Últimos lugares") : "Agotado")</span></div><div class="event-card-body"><h3>@item.Name</h3><p>@item.Description</p><dl><dt>⌖</dt><dd>@item.Venue</dd><dt>◷</dt><dd>@item.StartsAt.ToString("dddd, dd 'de' MMMM · HH:mm")</dd></dl></div><div class="event-card-footer"><a class="btn btn-dark w-100" asp-action="Details" asp-route-id="@item.Id">@(hasAvailability ? "Ver detalle" : "Ver evento") <span>→</span></a></div></article></div> }</div></section>
