@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{ ViewData["Title"] = "Roles"; var pageSummary = Model.Count == 0 ? "No hay roles creados." : $"Mostrando {Model.Count} rol(es)"; }
<section class="admin-page admin-roles-page">
    <div class="admin-heading d-flex justify-content-between align-items-start gap-3"><div><p class="kicker">ADMINISTRACIÓN</p><h1>Roles</h1><p>Define los perfiles disponibles para administrar el portal.</p></div><button class="btn btn-dark" type="button" data-bs-toggle="modal" data-bs-target="#createRoleModal">Nuevo rol</button></div>
    @if (TempData["Success"] is string success) { <div class="notice mb-3">✓ @success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="event-table-shell"><div class="event-table-summary"><span>@pageSummary</span><span class="event-table-page">Administración de accesos</span></div><div class="table-responsive"><table class="table event-admin-table role-admin-table mb-0"><thead><tr><th>Rol</th><th>Tipo</th><th>Estado</th><th aria-label="Acciones"></th></tr></thead><tbody>
    @if (!Model.Any()) { <tr><td colspan="4"><div class="event-table-empty"><span>✦</span><strong>Aún no hay roles</strong><p>Crea un rol para asignarlo a los usuarios.</p><button class="btn btn-dark btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#createRoleModal">Nuevo rol</button></div></td></tr> }
    @foreach (var role in Model) { var isProtected = role.Name is "SuperAdmin" or "Customer"; <tr><td><div class="role-row-title"><span class="role-row-mark">@((role.Name ?? "?")[0].ToString().ToUpperInvariant())</span><div><strong>@role.Name</strong><small>@(isProtected ? "Rol base del sistema" : "Rol personalizado")</small></div></div></td><td><span class="role-type @(isProtected ? "role-type-base" : "role-type-custom")">@(isProtected ? "Base" : "Personalizado")</span></td><td><span class="event-status @(isProtected ? "event-status-finished" : "event-status-live")">@(isProtected ? "Protegido" : "Disponible")</span></td><td class="event-menu-cell">@if (!isProtected) { <div class="dropdown"><button class="event-menu-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Acciones para @role.Name">•••</button><div class="dropdown-menu dropdown-menu-end event-row-menu"><a class="dropdown-item" asp-action="EditRole" asp-route-id="@role.Id">Editar rol</a><form asp-action="DeleteRole" asp-route-id="@role.Id" method="post" onsubmit="return confirm('¿Eliminar este rol? Esta acción no se puede deshacer.');"><button class="dropdown-item event-delete-action" type="submit">Eliminar rol</button></form></div></div> } else { <span class="role-protected-note">—</span> }</td></tr> }
    </tbody></table></div></div>
</section>
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content role-modal"><div class="modal-header"><div><p class="kicker">NUEVO ROL</p><h2 id="createRoleModalTitle">Crear rol</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><form asp-action="CreateRole" method="post"><div class="modal-body"><label class="form-label" for="Name">Nombre del rol</label><input class="form-control" id="Name" name="Name" maxlength="100" placeholder="Ej. Operador" required /><small>Usa letras, números, guiones o guiones bajos.</small></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-dark" type="submit">Crear rol</button></div></form></div></div></div>
