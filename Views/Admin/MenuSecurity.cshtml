@model TicketSales.Models.Admin.MenuSecurityViewModel
@{ ViewData["Title"] = "Seguridad de menú"; }
<section class="admin-page"><div class="admin-heading"><div><p class="kicker">SEGURIDAD</p><h1>Permisos de menú</h1><p>Define qué opciones administrativas puede abrir cada rol.</p></div></div>@if (TempData["Success"] is string success) { <div class="notice mb-3">✓ @success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }<div class="menu-security-list">@foreach (var role in Model.Roles) { var isSuperAdmin = role.RoleName == "SuperAdmin"; <form asp-action="SaveMenuSecurity" asp-route-roleId="@role.RoleId" method="post" class="menu-security-card"><div><h2>@role.RoleName</h2><p>@(isSuperAdmin ? "Acceso total protegido." : "Selecciona las opciones disponibles para este rol.")</p></div><div class="menu-security-options">@foreach (var option in Model.Options) { <label><input type="checkbox" name="menuKeys" value="@option.Key" checked="@(isSuperAdmin || role.GrantedKeys.Contains(option.Key))" disabled="@isSuperAdmin" /> @option.Title</label> }</div>@if (!isSuperAdmin) { <button class="btn btn-dark">Guardar permisos</button> }</form> }</div></section>
