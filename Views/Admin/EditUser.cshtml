@model TicketSales.Models.Admin.EditUserViewModel
@{ ViewData["Title"] = "Editar usuario"; }
<section class="admin-auth"><div class="checkout-card"><p class="kicker">ADMINISTRACIÓN</p><h1>Editar usuario</h1><form asp-action="EditUser" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control" autocomplete="username" /><span asp-validation-for="UserName" class="field-error"></span></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small class="text-muted">Déjala vacía para conservar la contraseña actual.</small><span asp-validation-for="Password" class="field-error d-block"></span></div><div class="mb-4"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select">@foreach (var role in Model.Roles) { <option value="@role">@role</option> }</select><span asp-validation-for="Role" class="field-error"></span></div><button class="btn btn-dark">Guardar cambios</button> <a class="btn btn-light" asp-action="Users">Cancelar</a></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
