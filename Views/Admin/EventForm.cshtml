@model TicketSales.Models.Admin.EventFormViewModel
@{
    var isNew = Model.Id == 0;
    var hasBanner = Model.HasExistingBanner;
    var fieldsWithErrors = ViewData.ModelState.Where(entry => entry.Value?.Errors.Count > 0).Select(entry => entry.Key).ToList();
    var activeTab = fieldsWithErrors.Any(field => field.StartsWith("TicketTypes", StringComparison.Ordinal)) ? "tickets"
        : fieldsWithErrors.Any(field => field is "Impulsar" or "Banner" or "RemoveBanner") ? "publishing"
        : "general";
    ViewData["Title"] = isNew ? "Nuevo evento" : "Editar evento";
}
<section class="admin-page event-form-page">
    <form id="eventForm" asp-action="@(isNew ? "CreateEvent" : "EditEvent")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <div class="admin-heading event-form-heading">
        <div><p class="kicker">EVENTOS</p><h1>@(isNew ? "Nuevo evento" : "Editar evento")</h1><p>Los eventos no publicados no se muestran en el portal público.</p></div>
        <div class="event-form-header-actions"><a class="btn btn-outline-secondary" asp-action="Events">Cancelar</a><button id="saveEvent" class="btn btn-dark" type="button">@(isNew ? "Crear evento" : "Guardar cambios")</button></div>
    </div>
    <div class="admin-form-card event-form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <nav class="event-form-tabs nav" role="tablist">
                <button class="@(activeTab == "general" ? "active" : "")" type="button" data-bs-toggle="tab" data-bs-target="#event-general" role="tab">Información general</button>
                <button class="@(activeTab == "tickets" ? "active" : "")" type="button" data-bs-toggle="tab" data-bs-target="#event-tickets" role="tab">Localidades</button>
                <button class="@(activeTab == "publishing" ? "active" : "")" type="button" data-bs-toggle="tab" data-bs-target="#event-publishing" role="tab">Publicación y banner</button>
            </nav>
            <div class="tab-content event-form-tab-content">
                <section class="tab-pane fade @(activeTab == "general" ? "show active" : "")" id="event-general" role="tabpanel">
                    <div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label">Nombre</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label">Estado</label><select asp-for="Status" class="form-select">@foreach (var status in EventStatuses.All) { <option value="@status">@status</option> }</select><span asp-validation-for="Status" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Description" class="form-label">Descripción</label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Venue" class="form-label">Lugar</label><input asp-for="Venue" class="form-control" /><span asp-validation-for="Venue" class="text-danger"></span></div><div class="col-md-6"><label asp-for="StartsAt" class="form-label">Fecha y hora</label><input asp-for="StartsAt" type="datetime-local" class="form-control" /><span asp-validation-for="StartsAt" class="text-danger"></span></div></div>
                </section>
                <section class="tab-pane fade @(activeTab == "tickets" ? "show active" : "")" id="event-tickets" role="tabpanel">
                    <div class="ticket-type-editor"><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><label class="form-label mb-0">Localidades</label><small class="d-block text-muted">Configura precio y disponibilidad por tipo de entrada.</small></div><button type="button" id="addTicketType" class="btn btn-outline-dark btn-sm">+ Agregar localidad</button></div><span asp-validation-for="TicketTypes" class="text-danger d-block mb-2"></span><div id="ticketTypeRows">@for (var index = 0; index < Model.TicketTypes.Count; index++) { <div class="ticket-type-row"><input type="hidden" name="TicketTypes[@index].Id" value="@Model.TicketTypes[index].Id" /><div><label class="form-label">Localidad</label><input name="TicketTypes[@index].Name" value="@Model.TicketTypes[index].Name" class="form-control" /><span asp-validation-for="TicketTypes[index].Name" class="text-danger"></span></div><div><label class="form-label">Precio (Q)</label><input name="TicketTypes[@index].Price" value="@Model.TicketTypes[index].Price" type="number" step="0.01" min="0.01" class="form-control" /><span asp-validation-for="TicketTypes[index].Price" class="text-danger"></span></div><div><label class="form-label">Disponibilidad</label><input name="TicketTypes[@index].AvailableTickets" value="@Model.TicketTypes[index].AvailableTickets" type="number" min="0" class="form-control" /><span asp-validation-for="TicketTypes[index].AvailableTickets" class="text-danger"></span></div><button type="button" class="btn btn-link text-danger remove-ticket-type">Quitar</button></div> }</div></div>
                </section>
                <section class="tab-pane fade @(activeTab == "publishing" ? "show active" : "")" id="event-publishing" role="tabpanel">
                    <div class="event-publish-panel"><div class="form-check"><input asp-for="Impulsar" class="form-check-input" /><label asp-for="Impulsar" class="form-check-label">Mostrar como evento destacado</label></div><span asp-validation-for="Impulsar" class="text-danger"></span></div>
                    <div class="event-banner-field"><div><label asp-for="Banner" class="form-label">Banner del evento</label><input asp-for="Banner" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" /><small class="text-muted">JPG, PNG, WEBP o GIF · máximo 5 MB. Al cargar uno nuevo reemplaza el actual.</small><span asp-validation-for="Banner" class="text-danger d-block"></span>@if (hasBanner) { <div class="form-check mt-2"><input asp-for="RemoveBanner" class="form-check-input" /><label asp-for="RemoveBanner" class="form-check-label">Quitar banner actual al guardar</label></div> }</div>@if (hasBanner) { <img src="@Url.Action("EventBannerPreview", new { id = Model.Id })" alt="Banner actual de @Model.Name" /> }</div>
                </section>
            </div>
    </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.addEventListener('DOMContentLoaded', function () { const form = document.getElementById('eventForm'); const save = document.getElementById('saveEvent'); const rows = document.getElementById('ticketTypeRows'); const add = document.getElementById('addTicketType'); save.addEventListener('click', () => form.requestSubmit()); form.addEventListener('invalid', event => { const pane = event.target.closest('.tab-pane'); if (pane) document.querySelector(`[data-bs-target="#${pane.id}"]`)?.click(); }, true); const renumber = () => rows.querySelectorAll('[name]').forEach((input) => { input.name = input.name.replace(/TicketTypes\[\d+\]/, `TicketTypes[${Array.from(rows.children).indexOf(input.closest('.ticket-type-row'))}]`); }); const remove = button => { if (rows.children.length === 1) return; button.closest('.ticket-type-row').remove(); renumber(); }; rows.addEventListener('click', event => { if (event.target.classList.contains('remove-ticket-type')) remove(event.target); }); add.addEventListener('click', () => { const index = rows.children.length; const row = document.createElement('div'); row.className = 'ticket-type-row'; row.innerHTML = `<input type="hidden" name="TicketTypes[${index}].Id" value="0" /><div><label class="form-label">Localidad</label><input name="TicketTypes[${index}].Name" class="form-control" placeholder="Ej. VIP" /></div><div><label class="form-label">Precio (Q)</label><input name="TicketTypes[${index}].Price" type="number" step="0.01" min="0.01" class="form-control" /></div><div><label class="form-label">Disponibilidad</label><input name="TicketTypes[${index}].AvailableTickets" type="number" min="0" class="form-control" value="0" /></div><button type="button" class="btn btn-link text-danger remove-ticket-type">Quitar</button>`; rows.appendChild(row); }); });</script> }
